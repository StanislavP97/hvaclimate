# Resend API key used by actions/contact.ts to email contact form submissions
# to Office@HVAClimate.com. Get one at https://resend.com/api-keys.
#
# If unset, contact form submissions are logged to the server console instead
# of sent, so the form still works end-to-end during local development.
RESEND_API_KEY=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Loaded site-wide from
# app/layout.tsx. If unset, the GTM script and noscript iframe are omitted.
NEXT_PUBLIC_GTM_ID=

# RentCast API key used by app/api/property-lookup/route.ts to auto-fill home
# details (square footage, year built, heating type, etc.) from an address.
# Get one at https://app.rentcast.io/app/api.
#
# If unset, the property lookup endpoint returns {found: false} for every
# address, so the instant-quote flow falls back to manual entry.
RENTCAST_API_KEY=

# Google Places API key used by components/instant-quote/AddressAutocomplete.tsx
# for address autocomplete in the instant-quote wizard. Get one at
# https://console.cloud.google.com/google/maps-apis/credentials (enable the
# "Places API"). Public by design — restrict it to your domain via HTTP
# referrer restrictions in the Google Cloud Console, not by keeping it secret.
#
# If unset, the address field falls back to a plain text input with no
# autocomplete.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
